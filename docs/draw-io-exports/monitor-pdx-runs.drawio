          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Workflow Run Update Event → Success (end of map) -->
        <mxCell id="e18" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="n16" target="n18" parent="1">
